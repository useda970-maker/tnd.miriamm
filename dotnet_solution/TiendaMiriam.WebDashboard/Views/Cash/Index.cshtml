@model IEnumerable<TiendaMiriam.Core.Entities.CashClosing>
@{
    ViewData["Title"] = "Control de Cajas";
    var active = ViewBag.ActiveSession as TiendaMiriam.Core.Entities.CashSession;
}

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-black text-white">Control de Cajas & Arqueos</h1>
        <p class="text-xs text-slate-400">Supervisión remota de turnos de cajeros, fondos y discrepancias de efectivo.</p>
    </div>

    <!-- Active Session Card -->
    @if (active != null)
    {
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full @(active.IsOpen ? "bg-emerald-400 animate-pulse" : "bg-rose-500")"></span>
                    <span class="text-sm font-bold text-white">Turno Actual: @(active.IsOpen ? "Abierto y en Operación" : "Cerrado")</span>
                </div>
                <span class="text-xs font-mono text-slate-400">Responsable: @active.OpenedBy</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-[11px] text-slate-400 block">Fondo Inicial</span>
                    <span class="text-xl font-bold font-mono text-white mt-1 block">Bs. @active.InitialCash.ToString("N2")</span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-[11px] text-slate-400 block">Ventas en Efectivo</span>
                    <span class="text-xl font-bold font-mono text-emerald-400 mt-1 block">+Bs. @active.CashSales.ToString("N2")</span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-[11px] text-slate-400 block">Egresos (Gastos + Compras)</span>
                    <span class="text-xl font-bold font-mono text-rose-400 mt-1 block">-Bs. @((active.CashExpenses + active.GenericPurchasesInCash).ToString("N2"))</span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-800/60 border border-emerald-500/40">
                    <span class="text-[11px] text-slate-400 block">Efectivo Teórico Esperado</span>
                    <span class="text-xl font-bold font-mono text-white mt-1 block">Bs. @active.ExpectedCash.ToString("N2")</span>
                </div>
            </div>
        </div>
    }

    <!-- Historical Closings Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl">
        <h3 class="text-sm font-bold text-white mb-4">Historial de Cierres de Caja</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-800 text-slate-300 font-semibold border-b border-slate-700">
                    <tr>
                        <th class="py-2.5 px-3">Código</th>
                        <th class="py-2.5 px-3">Cierre</th>
                        <th class="py-2.5 px-3">Cajero</th>
                        <th class="py-2.5 px-3">Esperado</th>
                        <th class="py-2.5 px-3">Contado</th>
                        <th class="py-2.5 px-3">Diferencia</th>
                        <th class="py-2.5 px-3">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="py-2.5 px-3 font-mono font-bold text-white">@c.SessionCode</td>
                            <td class="py-2.5 px-3 text-slate-400">@c.ClosedAt.ToString("g")</td>
                            <td class="py-2.5 px-3 text-slate-300">@c.ClosedBy</td>
                            <td class="py-2.5 px-3 font-mono">Bs. @c.ExpectedCash.ToString("N2")</td>
                            <td class="py-2.5 px-3 font-mono font-bold text-white">Bs. @c.ActualCashCounted.ToString("N2")</td>
                            <td class="py-2.5 px-3 font-mono">
                                @if (c.Difference == 0)
                                {
                                    <span class="text-emerald-400 font-bold">Bs. 0.00</span>
                                }
                                else if (c.Difference > 0)
                                {
                                    <span class="text-cyan-400 font-bold">+Bs. @c.Difference.ToString("N2") (Sobrante)</span>
                                }
                                else
                                {
                                    <span class="text-rose-400 font-bold">Bs. @c.Difference.ToString("N2") (Faltante)</span>
                                }
                            </td>
                            <td class="py-2.5 px-3">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold @(c.Status == "CUADRADA" ? "bg-emerald-500/20 text-emerald-400" : "bg-rose-500/20 text-rose-400")">
                                    @c.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
