@model IEnumerable<TiendaMiriam.Core.Entities.AuditLog>
@{
    ViewData["Title"] = "Auditoría Forense";
}

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-black text-white">Auditoría Forense Empresarial</h1>
        <p class="text-xs text-slate-400">Bitácora inalterable de cada evento crítico: cambios de precios, modificación de recetas, stock o aperturas de caja.</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-800 text-slate-300 font-semibold border-b border-slate-700">
                    <tr>
                        <th class="py-2.5 px-3">Fecha y Hora</th>
                        <th class="py-2.5 px-3">Usuario</th>
                        <th class="py-2.5 px-3">Acción Crítica</th>
                        <th class="py-2.5 px-3">Objetivo / Ítem</th>
                        <th class="py-2.5 px-3">Detalle</th>
                        <th class="py-2.5 px-3">Anterior</th>
                        <th class="py-2.5 px-3">Nuevo</th>
                        <th class="py-2.5 px-3">Justificación</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @foreach (var log in Model)
                    {
                        <tr class="hover:bg-slate-800/40">
                            <td class="py-2.5 px-3 font-mono text-slate-400 whitespace-nowrap">@log.Timestamp.ToString("g")</td>
                            <td class="py-2.5 px-3 font-bold text-white whitespace-nowrap">@log.UserName</td>
                            <td class="py-2.5 px-3">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 border border-slate-700 text-slate-200">
                                    @log.Action
                                </span>
                            </td>
                            <td class="py-2.5 px-3 font-semibold text-slate-300">@log.TargetItem</td>
                            <td class="py-2.5 px-3 text-slate-400 max-w-xs truncate" title="@log.Details">@log.Details</td>
                            <td class="py-2.5 px-3 font-mono text-slate-500">@(log.PreviousValue ?? "-")</td>
                            <td class="py-2.5 px-3 font-mono text-emerald-400 font-bold">@(log.NewValue ?? "-")</td>
                            <td class="py-2.5 px-3 text-slate-300 italic">@(log.Reason ?? "Sin motivo")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
