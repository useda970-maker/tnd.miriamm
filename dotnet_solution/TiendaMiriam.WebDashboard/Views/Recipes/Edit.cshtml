@model TiendaMiriam.WebDashboard.Models.RecipeEditViewModel
@{
    ViewData["Title"] = "Escandallo y Receta Libre";
}

<div class="max-w-4xl mx-auto w-full">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xl font-extrabold text-white">Escandallo y Receta Libre:</span>
                    <span class="text-xl font-extrabold text-amber-400">@Model.ProductName</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">
                    Configure insumos en cualquier unidad de medida (g, kg, lb, oz, ml, L, un). El sistema calcula el costo y descuenta atómicamente en cada venta.
                </p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="text-xs text-slate-400 hover:text-white">← Volver al Catálogo</a>
        </div>

        <form asp-action="Save" method="post" id="recipeForm" class="flex flex-col gap-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            <!-- Ingredients Table -->
            <div>
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-bold text-white">Insumos y Materias Primas Consumidas</h3>
                    <button type="button" onclick="addIngredientRow()" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition shadow-xs">
                        + Añadir Insumo a la Receta
                    </button>
                </div>

                <div class="space-y-3" id="ingredientsList">
                    @for (int i = 0; i < Model.Ingredients.Count; i++)
                    {
                        <div class="ingredient-row p-3 rounded-xl bg-slate-800/70 border border-slate-700/60 flex flex-wrap items-center gap-3">
                            <div class="flex-1 min-w-[200px]">
                                <label class="text-[10px] text-slate-400 block mb-0.5">Insumo / Materia Prima</label>
                                <select name="Ingredients[@i].IngredientProductId" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white">
                                    @foreach (var raw in Model.AvailableRawProducts)
                                    {
                                        <option value="@raw.Id" selected="@(raw.Id == Model.Ingredients[i].IngredientProductId)">
                                            @raw.Name (Costo: Bs. @raw.CostPrice.ToString("F2")/@raw.Unit)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="w-28">
                                <label class="text-[10px] text-slate-400 block mb-0.5">Cantidad Exacta</label>
                                <input type="number" step="0.001" min="0.001" name="Ingredients[@i].Quantity" value="@Model.Ingredients[i].Quantity" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white font-mono" />
                            </div>

                            <div class="w-28">
                                <label class="text-[10px] text-slate-400 block mb-0.5">Unidad Libre</label>
                                <select name="Ingredients[@i].Unit" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white">
                                    <option value="g" selected="@(Model.Ingredients[i].Unit == "g")">Gramos (g)</option>
                                    <option value="kg" selected="@(Model.Ingredients[i].Unit == "kg")">Kilos (kg)</option>
                                    <option value="lb" selected="@(Model.Ingredients[i].Unit == "lb")">Libras (lb)</option>
                                    <option value="oz" selected="@(Model.Ingredients[i].Unit == "oz")">Onzas (oz)</option>
                                    <option value="ml" selected="@(Model.Ingredients[i].Unit == "ml")">Mililitros (ml)</option>
                                    <option value="L" selected="@(Model.Ingredients[i].Unit == "L")">Litros (L)</option>
                                    <option value="un" selected="@(Model.Ingredients[i].Unit == "un")">Unidad (un)</option>
                                </select>
                            </div>

                            <button type="button" onclick="this.closest('.ingredient-row').remove()" class="p-1.5 text-rose-400 hover:text-rose-300 rounded-lg mt-3" title="Eliminar insumo">
                                🗑️
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Mandatory Forensic Audit Reason -->
            <div>
                <label class="block text-xs font-bold text-amber-400 mb-1">
                    Motivo / Justificación para la Auditoría Forense (Obligatorio)
                </label>
                <input asp-for="AuditReason" required placeholder="Ej. Ajuste de gramaje de carne por cambio de proveedor..." class="w-full px-3 py-2 bg-slate-800 border border-amber-500/40 rounded-xl text-xs text-white" />
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <a asp-controller="Products" asp-action="Index" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white bg-slate-800">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg">
                    Guardar Receta y Actualizar Costo Automáticamente
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function addIngredientRow() {
        const list = document.getElementById('ingredientsList');
        const count = list.querySelectorAll('.ingredient-row').length;
        const row = document.createElement('div');
        row.className = 'ingredient-row p-3 rounded-xl bg-slate-800/70 border border-slate-700/60 flex flex-wrap items-center gap-3';
        row.innerHTML = `
            <div class="flex-1 min-w-[200px]">
                <label class="text-[10px] text-slate-400 block mb-0.5">Insumo / Materia Prima</label>
                <select name="Ingredients[\${count}].IngredientProductId" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white">
                    @foreach (var raw in Model.AvailableRawProducts)
                    {
                        <text><option value="@raw.Id">@raw.Name (Costo: Bs. @raw.CostPrice.ToString("F2")/@raw.Unit)</option></text>
                    }
                </select>
            </div>
            <div class="w-28">
                <label class="text-[10px] text-slate-400 block mb-0.5">Cantidad Exacta</label>
                <input type="number" step="0.001" min="0.001" name="Ingredients[\${count}].Quantity" value="1" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white font-mono" />
            </div>
            <div class="w-28">
                <label class="text-[10px] text-slate-400 block mb-0.5">Unidad Libre</label>
                <select name="Ingredients[\${count}].Unit" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white">
                    <option value="g">Gramos (g)</option>
                    <option value="kg">Kilos (kg)</option>
                    <option value="lb">Libras (lb)</option>
                    <option value="oz">Onzas (oz)</option>
                    <option value="ml">Mililitros (ml)</option>
                    <option value="L">Litros (L)</option>
                    <option value="un">Unidad (un)</option>
                </select>
            </div>
            <button type="button" onclick="this.closest('.ingredient-row').remove()" class="p-1.5 text-rose-400 hover:text-rose-300 rounded-lg mt-3" title="Eliminar insumo">
                🗑️
            </button>
        `;
        list.appendChild(row);
    }
</script>
