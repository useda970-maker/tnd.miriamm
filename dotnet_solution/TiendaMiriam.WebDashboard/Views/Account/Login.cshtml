@model TiendaMiriam.WebDashboard.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Tienda Miriam Panel Dueño</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl">
        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center font-black text-white text-2xl mx-auto mb-3 shadow-lg">
                TM
            </div>
            <h1 class="text-2xl font-extrabold text-white">Panel Web Empresarial</h1>
            <p class="text-xs text-slate-400 mt-1">Acceso Administrativo para Doña Miriam Suárez</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-4 p-3 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300 text-xs font-semibold text-center">
                @Model.ErrorMessage
            </div>
        }

        <form asp-action="Login" method="post" class="flex flex-col gap-4">
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Usuario</label>
                <input asp-for="Username" value="miriam" required class="w-full px-3.5 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-hidden focus:border-emerald-500 font-mono" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Contraseña</label>
                <input asp-for="Password" type="password" value="Miriam2026!" required class="w-full px-3.5 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-hidden focus:border-emerald-500 font-mono" />
            </div>

            <button type="submit" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition shadow-lg mt-2 cursor-pointer">
                Ingresar al Panel Dueño
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-800 text-center">
            <span class="text-[11px] text-slate-500 block">Credenciales precargadas de demostración:</span>
            <span class="text-xs font-mono text-emerald-400 font-bold block mt-1">Usuario: miriam / Clave: Miriam2026!</span>
        </div>
    </div>
</body>
</html>
