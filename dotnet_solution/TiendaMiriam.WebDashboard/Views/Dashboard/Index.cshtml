@model TiendaMiriam.WebDashboard.Models.DashboardViewModel
@{
    ViewData["Title"] = "Métricas en Vivo";
}

<!-- Top Executive Welcome & Quick Action -->
<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-black text-white tracking-tight">Bienvenida, @Model.OwnerName</h1>
        <p class="text-xs text-slate-400">Resumen financiero consolidado y estado operativo en tiempo real</p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-controller="Products" asp-action="Create" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg transition">
            + Nuevo Producto / Insumo
        </a>
    </div>
</div>

<!-- 4 High-Impact KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
        <div class="text-xs font-bold uppercase text-slate-400 mb-1">Ventas Brutas Totales</div>
        <div class="text-2xl font-black text-white font-mono">Bs. @Model.TotalSalesAmount.ToString("N2")</div>
        <div class="text-xs text-emerald-400 mt-1 font-semibold">@Model.TotalSalesCount pedidos completados</div>
    </div>

    <!-- Card 2 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
        <div class="text-xs font-bold uppercase text-slate-400 mb-1">Costo de Ventas (COGS)</div>
        <div class="text-2xl font-black text-white font-mono">Bs. @Model.TotalCOGS.ToString("N2")</div>
        <div class="text-xs text-slate-400 mt-1">Escandallo e insumos deducidos</div>
    </div>

    <!-- Card 3 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
        <div class="text-xs font-bold uppercase text-slate-400 mb-1">Margen Bruto Real</div>
        <div class="text-2xl font-black text-emerald-400 font-mono">@Model.GrossMarginPercent.ToString("F1")%</div>
        <div class="text-xs text-slate-300 mt-1">Ganancia: Bs. @Model.GrossProfit.ToString("N2")</div>
    </div>

    <!-- Card 4 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
        <div class="text-xs font-bold uppercase text-slate-400 mb-1">Efectivo en Caja Mostrador</div>
        <div class="text-2xl font-black text-white font-mono">Bs. @Model.CurrentCashInRegister.ToString("N2")</div>
        <div class="text-xs mt-1 @(Model.IsCashRegisterOpen ? "text-emerald-400" : "text-rose-400") font-bold">
            @(Model.IsCashRegisterOpen ? "● Turno Activo" : "● Caja Cerrada")
        </div>
    </div>
</div>

<!-- Charts & Tables Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Payment Distribution -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
        <h3 class="text-sm font-bold text-white mb-4">Distribución por Método de Cobro</h3>
        <div class="space-y-3">
            @foreach (var entry in Model.PaymentDistribution)
            {
                var pct = Model.TotalSalesAmount > 0 ? (entry.Value / Model.TotalSalesAmount) * 100 : 0;
                <div>
                    <div class="flex justify-between text-xs font-semibold mb-1">
                        <span class="text-slate-300">@entry.Key</span>
                        <span class="font-mono text-white">Bs. @entry.Value.ToString("N2") (@pct.ToString("F1")%)</span>
                    </div>
                    <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden">
                        <div class="bg-emerald-500 h-full rounded-full" style="width: @pct.ToString("F0")%"></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Top Margin Products -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
        <h3 class="text-sm font-bold text-white mb-4">Productos con Mayor Margen</h3>
        <div class="space-y-3">
            @foreach (var p in Model.TopProducts)
            {
                var margin = p.Price > 0 ? ((p.Price - p.CostPrice) / p.Price) * 100 : 0;
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <div>
                        <div class="text-xs font-bold text-white">@p.Name</div>
                        <div class="text-[11px] text-slate-400">Venta: Bs. @p.Price.ToString("F2") | Costo: Bs. @p.CostPrice.ToString("F2")</div>
                    </div>
                    <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                        +@margin.ToString("F0")%
                    </span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Sales Table -->
<div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
    <h3 class="text-sm font-bold text-white mb-4">Últimas Ventas Registradas</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-800 text-slate-300 font-semibold border-b border-slate-700">
                <tr>
                    <th class="py-2.5 px-3">Recibo</th>
                    <th class="py-2.5 px-3">Fecha y Hora</th>
                    <th class="py-2.5 px-3">Cajero</th>
                    <th class="py-2.5 px-3">Método</th>
                    <th class="py-2.5 px-3 text-right">Total</th>
                    <th class="py-2.5 px-3 text-center">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                @foreach (var s in Model.RecentSales)
                {
                    <tr>
                        <td class="py-2.5 px-3 font-mono font-bold text-white">@s.ReceiptNumber</td>
                        <td class="py-2.5 px-3 text-slate-400">@s.Timestamp.ToString("g")</td>
                        <td class="py-2.5 px-3 text-slate-300">@s.CashierName</td>
                        <td class="py-2.5 px-3 font-semibold text-slate-200">@s.PaymentMethod</td>
                        <td class="py-2.5 px-3 font-mono text-emerald-400 font-bold text-right">Bs. @s.Total.ToString("N2")</td>
                        <td class="py-2.5 px-3 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400">@s.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
